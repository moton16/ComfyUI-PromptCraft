  "ModelLoraGroupLoader": {
    "display_name": "Model & LoRA Group Loader",
    "description": "加载底模并应用 LoRA 栈（个体 LoRA + 群组引用混合）。前端管理栈状态，后端执行时解析。",
    "inputs": {
      "checkpoint": {
        "name": "底模",
        "tooltip": "选择底模，'None' 则使用上游传入的 MODEL"
      },
      "strength_multiplier": {
        "name": "权重乘数",
        "tooltip": "全局 LoRA 权重乘数"
      },
      "model": { "name": "MODEL" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "lora_stack_data": { "name": "LoRA 栈数据" }
    },
    "outputs": {
      "model": { "name": "model" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "lora_prompt_data": { "name": "LoRA Prompt 数据", "tooltip": "LoRA 触发词和提示词的 JSON 数据" }
    }
  },

  "LoraPromptLoader": {
    "display_name": "LoRA Prompt Loader",
    "description": "加载底模 + LoRA 栈，自动合并 LoRA prompt 与用户文本。输出纯文本 STRING，可直接接入标准 CLIP 编码器。",
    "inputs": {
      "checkpoint": {
        "name": "底模",
        "tooltip": "选择底模，'None' 则使用上游传入的 MODEL"
      },
      "strength_multiplier": {
        "name": "权重乘数",
        "tooltip": "全局 LoRA 权重乘数"
      },
      "positive_text": {
        "name": "正面提示词",
        "tooltip": "用户正面提示词（LoRA prompt 将自动添加在最前面）"
      },
      "negative_text": {
        "name": "负面提示词",
        "tooltip": "用户负面提示词（LoRA negative 将自动添加在最前面）"
      },
      "model": { "name": "MODEL" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "lora_stack_data": { "name": "LoRA 栈数据" }
    },
    "outputs": {
      "model": { "name": "model" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "positive_text": { "name": "正面提示词", "tooltip": "合并后的正面提示词文本" },
      "negative_text": { "name": "负面提示词", "tooltip": "合并后的负面提示词文本" }
    }
  },

  "CLIPTextEncodePro": {
    "display_name": "CLIP Text Encode Pro",
    "description": "标准 CLIP 文本编码器升级版，额外支持 text2 输入。自动合并两段文本后一起编码为 CONDITIONING。",
    "inputs": {
      "text1": { "name": "文本 1", "tooltip": "主文本输入" },
      "clip": { "name": "CLIP" },
      "text2": { "name": "文本 2", "tooltip": "可选的第二段文本，将与文本 1 合并" }
    },
    "outputs": {
      "0": { "name": "CONDITIONING", "tooltip": "编码后的条件输出" }
    }
  }
}
