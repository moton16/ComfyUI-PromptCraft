  "AIChat": {
    "display_name": "AI Chat",
    "description": "AI chat node for interactive conversations with LLM"
  },

  "ModelLoraGroupLoader": {
    "display_name": "Model & LoRA Group Loader",
    "description": "Load base model and apply LoRA stack (individual LoRA + group references). Frontend manages stack state, backend parses at execution.",
    "inputs": {
      "checkpoint": {
        "name": "Checkpoint",
        "tooltip": "Select base model, 'None' to use upstream MODEL"
      },
      "strength_multiplier": {
        "name": "Strength Multiplier",
        "tooltip": "Global LoRA weight multiplier"
      },
      "model": { "name": "MODEL" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "lora_stack_data": { "name": "LoRA Stack Data" }
    },
    "outputs": {
      "model": { "name": "model" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "lora_prompt_data": { "name": "LoRA Prompt Data", "tooltip": "JSON data of LoRA trigger words and prompts" }
    }
  },

  "LoraPromptLoader": {
    "display_name": "LoRA Prompt Loader",
    "description": "Load base model + LoRA stack, auto-merge LoRA prompts with user text. Outputs plain STRING, directly compatible with standard CLIP encoders.",
    "inputs": {
      "checkpoint": {
        "name": "Checkpoint",
        "tooltip": "Select base model, 'None' to use upstream MODEL"
      },
      "strength_multiplier": {
        "name": "Strength Multiplier",
        "tooltip": "Global LoRA weight multiplier"
      },
      "positive_text": {
        "name": "Positive Prompt",
        "tooltip": "User positive prompt (LoRA prompts will be auto-prepended)"
      },
      "negative_text": {
        "name": "Negative Prompt",
        "tooltip": "User negative prompt (LoRA negatives will be auto-prepended)"
      },
      "model": { "name": "MODEL" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "lora_stack_data": { "name": "LoRA Stack Data" }
    },
    "outputs": {
      "model": { "name": "model" },
      "clip": { "name": "CLIP" },
      "vae": { "name": "VAE" },
      "positive_text": { "name": "Positive Prompt", "tooltip": "Merged positive prompt text" },
      "negative_text": { "name": "Negative Prompt", "tooltip": "Merged negative prompt text" }
    }
  },

  "CLIPTextEncodePro": {
    "display_name": "CLIP Text Encode Pro",
    "description": "Enhanced CLIP text encoder with additional text2 input. Auto-merges two text inputs before encoding to CONDITIONING.",
    "inputs": {
      "text1": { "name": "Text 1", "tooltip": "Primary text input" },
      "clip": { "name": "CLIP" },
      "text2": { "name": "Text 2", "tooltip": "Optional second text, merged with Text 1" }
    },
    "outputs": {
      "0": { "name": "CONDITIONING", "tooltip": "Encoded conditioning output" }
    }
  }
}
